{
  "name": "t3-quest",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/run-node.mjs bridge/server.mjs",
    "test": "node scripts/run-node.mjs --test tests/*.test.mjs",
    "setup:voice": "python3 scripts/setup-voice.py",
    "pair": "node scripts/run-node.mjs scripts/pair.mjs",
    "connect:quest": "node scripts/run-node.mjs scripts/connect-quest.mjs",
    "demo:alert": "node scripts/run-node.mjs scripts/demo-alert.mjs",
    "report": "node scripts/run-node.mjs scripts/report.mjs",
    "build:android": "bash scripts/build-android.sh",
    "install:quest": "bash scripts/quest.sh install",
    "preview": "node scripts/run-node.mjs scripts/preview.mjs",
    "test:browser": "node scripts/run-node.mjs node_modules/@playwright/test/cli.js test",
    "setup:desktop": "node scripts/run-node.mjs scripts/setup-desktop.mjs",
    "package:desktop": "node scripts/run-node.mjs scripts/package-desktop-copy.mjs",
    "start:desktop": "T3_QUEST_SOURCE=desktop node scripts/run-node.mjs bridge/server.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "dompurify": "3.4.17",
    "jsdom": "30.1.3",
    "marked": "18.1.2"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
