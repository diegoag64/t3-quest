# Default bridge listens on localhost. For Wi-Fi testing, bind your private LAN:
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8787

# Optional speech-to-text endpoint accepting multipart file/model and returning
# JSON {"text":"..."}. Leave blank for local recording and playback only.
# TRANSCRIPTION_URL=http://127.0.0.1:8080/v1/audio/transcriptions
# TRANSCRIPTION_MODEL=whisper-1
# TRANSCRIPTION_KEY=
