# Wi-Fi testing: bind your private LAN. Default without this setting is loopback.
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8787

# Run npm run setup:voice to save hosted transcription settings in ignored .env.
# The bridge uploads a recording only after Stop & transcribe or the 60-second limit.
# OpenRouter (uses your OpenRouter credits):
# TRANSCRIPTION_PROVIDER=openrouter
# TRANSCRIPTION_URL=https://openrouter.ai/api/v1/audio/transcriptions
# TRANSCRIPTION_MODEL=microsoft/mai-transcribe-2
# TRANSCRIPTION_KEY=
# Wispr Flow (requires approved developer API access):
# TRANSCRIPTION_PROVIDER=wispr
# TRANSCRIPTION_URL=https://platform-api.wisprflow.ai/api/v1/dash/api
# TRANSCRIPTION_KEY=
# Or OpenAI:
# TRANSCRIPTION_PROVIDER=openai
# TRANSCRIPTION_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIPTION_MODEL=gpt-transcribe
# TRANSCRIPTION_KEY=
